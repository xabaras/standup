projects_root: ~/code

# Optional: map repo directory names to display names (often hashtags)
# Useful if you use project hashtags on communities like wip.co
# Example: local repo "daily-journal" maps to "#dailyjournal" (same as your wip.co project name)
repo_name_mapping:
  habit-tracker: "#habittracker"
  ebook-finder: "#ebookfinder"
  daily-journal: "#dailyjournal"

# Optional: repositories to keep out of the report.
# Every repository under projects_root is reported unless it is named here, so
# a new one shows up on its own. Use this for the work a published standup
# should not mention — a client's code, or anything not announced yet.
exclude_repos:
  - some-client-work
  - unannounced-side-project

# Optional: title of the shared message. {date} is replaced with YYYY-MM-DD.
# Default if omitted: 📋 Daily Standup — {date}
# share_header: "📋 Building in public — {date}"

# Optional: text appended after the report (Telegram, X, wip.co, LinkedIn).
# Write only the footer text — a blank line before it is added automatically.
# share_footer: "#buildinpublic #indiehackers"
